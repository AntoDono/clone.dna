# Optional — without this, unauthenticated GitHub API is used (60 req/hr limit, enough for dev).
# Add a real token (no special scopes needed) to raise the limit to 5000 req/hr.
# Get one at: https://github.com/settings/tokens
GITHUB_TOKEN=

XAI_API_KEY=xai-your_key_here
DB_PATH=clone_dna.db
BASE_MODEL=Qwen/Qwen3.5-27B-GPTQ-Int4 # MUST BE A HUGGINGFACE MODEL PATH, can be a gptq quantized model
CUDA_VISIBLE_DEVICES=2
NUM_OF_PARALLEL_TRAINING=4
# Optional: cache Grok-generated training pairs + system prompts (skips Grok API on re-runs)
# GROK_CACHE_DIR=grok_cache
# Optional: quantize BASE_MODEL locally to GPTQ-IntN on first run, cache in QUANTIZED_MODELS_DIR
# QUANTIZATION_BITS=4
# QUANTIZED_MODELS_DIR=quantized_models
QUANTIZATION_BITS=4
# Optional: workspace root for agent tool use (auto-created per team)
# AGENT_WORKSPACE_DIR=agent-workspace